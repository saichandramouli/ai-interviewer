# Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://ai_interviewer_user:your_password_here@localhost:5432/ai_interviewer_db

# Django Core Settings
DJANGO_SECRET_KEY=your_generated_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis / Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI APIs (Do not commit real keys to version control)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini

# NVIDIA Nemotron AI Dialogue Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Speech-to-Text (STT) Configuration
# Supported providers: "mock", "deepgram"
STT_PROVIDER=mock
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3

# Text-to-Speech (TTS) Configuration
# Supported providers: "mock", "elevenlabs"
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1/text-to-speech
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_email_service_password_or_api_key_here
DEFAULT_FROM_EMAIL=AI Interviewer <noreply@yourdomain.com>
